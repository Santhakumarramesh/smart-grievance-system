# Smart Grievance System - Environment Configuration
# Copy this file to .env for local usage.
# For production, set equivalent values in your host dashboard (Render, etc.).

# ============================================================
# REQUIRED IN PRODUCTION
# ============================================================
FLASK_ENV=development
SECRET_KEY=replace-with-strong-random-secret
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///grievance.db

# ============================================================
# EMAIL DELIVERY
# ============================================================
# Keep false in production. Set true only for local debugging.
DEMO_EMAIL_MODE=false
# Phone OTP is disabled by default unless explicit demo SMS mode is enabled.
DEMO_SMS_MODE=false

# SMTP settings (required only when DEMO_EMAIL_MODE=false)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Smart Grievance System <noreply@grievance.gov>

# ============================================================
# AUTH TOKEN SETTINGS
# ============================================================
JWT_RESET_TOKEN_EXPIRES_MINUTES=15
ENABLE_REFRESH_TOKENS=true
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ============================================================
# APP + BACKGROUND WORKERS
# ============================================================
PORT=8000
AUTO_CREATE_TABLES=false
ENABLE_STARTUP_MODEL_LOAD=true
ENABLE_SCHEDULER=true
SCHEDULER_AUTOSTART=false
ENABLE_SCHEDULED_RETRAIN=true
RETRAIN_INTERVAL_HOURS=168

# ============================================================
# ML TRIAGE SETTINGS
# ============================================================
ML_AUTO_ASSIGN_CONFIDENCE_THRESHOLD=0.65
ML_MANUAL_REVIEW_DEPARTMENT=Manual Review Queue

# ============================================================
# LOCAL/PROD PROFILE REFERENCE
# ============================================================
# Local dev:
#   FLASK_ENV=development
#   DATABASE_URL=sqlite:///grievance.db
#   APP_BASE_URL=http://localhost:8000
#   DEMO_EMAIL_MODE=true (optional for local console delivery)
#
# Production deployment:
#   FLASK_ENV=production
#   DATABASE_URL=<postgresql://...>
#   SECRET_KEY=<strong random secret>
#   DEMO_EMAIL_MODE=false
#   DEMO_SMS_MODE=false
#   MAIL_USERNAME=<smtp user>
#   MAIL_PASSWORD=<smtp password>
#   APP_BASE_URL=https://<your-domain>
